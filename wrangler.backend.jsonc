{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openfront-strategy-backend",
  "main": "src/cloudflare/worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GameRoom"
      },
      {
        "name": "DIRECTORY",
        "class_name": "LobbyDirectory"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameRoom",
        "LobbyDirectory"
      ]
    }
  ],
  "vars": {
    "BUILD_ID": "e11ea4b42e75fad1",
    "ALLOWED_ORIGINS": "https://openfront-strategy.pages.dev,http://localhost:8788,http://127.0.0.1:8788"
  }
}
